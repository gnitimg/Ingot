# Provider URLs and API Keys are configured per browser device and must never be stored here.
# Non-secret defaults for a new device:
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=90

# Chat + knowledge-graph extraction
CHAT_MODEL=Qwen/Qwen3-8B
CHAT_TIMEOUT=180
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=2048
QA_EVIDENCE_COUNT=6

# OCR for images and scanned PDF pages
OCR_ENABLED=true
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
OCR_TIMEOUT=240
OCR_CONCURRENCY=2
OCR_MIN_TEXT_CHARS=80
OCR_MAX_PAGES=100
OCR_RENDER_DPI=144

# Optional second-stage reranker
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=18
RERANK_TIMEOUT=60

# Retrieval and ingestion tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=160
DEFAULT_TOP_K=6
# Graph model request concurrency: 1-1000. Start with 3-5 unless the provider explicitly allows more.
GRAPH_CONCURRENCY=3
GRAPH_MAX_CHUNKS=0
GRAPH_CHUNK_TIMEOUT=240
GRAPH_BUILD_TIMEOUT=3600
GRAPH_RETRY_ROUNDS=2
GRAPH_RETRY_BACKOFF=2
GRAPH_SUCCESS_THRESHOLD=90
GRAPH_LLM_ENTITY_MATCHING=false

# Local storage
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=50
# Required in production. Generate a stable high-entropy value on the server.
DEVICE_COOKIE_SECRET=
