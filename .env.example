# SiliconFlow embeddings (required)
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-m3

# Chat + knowledge-graph extraction. Empty values reuse the embedding endpoint/key.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=Qwen/Qwen3-8B

# OCR. Empty endpoint/key reuse the embedding service. OCR is used for images and scanned PDF pages.
OCR_ENABLED=true
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
OCR_CONCURRENCY=2
OCR_MIN_TEXT_CHARS=80
OCR_MAX_PAGES=100
OCR_RENDER_DPI=144

# Optional second-stage reranker. Empty endpoint/key reuse the embedding service.
RERANK_ENABLED=true
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=18

# Retrieval and ingestion tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=160
EMBEDDING_BATCH_SIZE=16
DEFAULT_TOP_K=6
GRAPH_CONCURRENCY=3
GRAPH_MAX_CHUNKS=0

# Local storage
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=50
